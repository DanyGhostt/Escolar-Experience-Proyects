// ------------------------------------------------------------------------------
// Configuracion Inicial / System Setup
// ------------------------------------------------------------------------------
void setup() {
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  Serial.begin(9600);
  display.clearDisplay();

  // Presentacion institucional / Presentation splash screens
  display.drawBitmap(0, 0, Logo_ITS, 128, 64, WHITE);
  display.display();
  delay(2000);
  display.clearDisplay();

display.drawBitmap(0, 0, LOGO, 128, 64, WHITE);
  display.display();
  delay(2000);
  display.clearDisplay();
  
  delay(2000);
  display.clearDisplay(); // Portada / Cover info
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.println("MICROCONTROLADORES");
display.println("P4-Encoder Optico");
display.display(); 
  delay(3000);
  display.clearDisplay();
}

// ------------------------------------------------------------------------------
// Bucle Principal / Main Loop (Decodificacion FSM del Encoder)
// ------------------------------------------------------------------------------
void loop() {
  // Estado 1: En espera de entrada (Reposo 00)
  // State 1: Idle waiting for input (00)
  estado1:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EN ESPERA DE ENTRADA ");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.drawCircle(10, 60, 7, WHITE);
    display.drawCircle(30, 60, 7, WHITE);
    display.drawCircle(50, 60, 7, WHITE);
    display.drawCircle(80, 60, 7, WHITE);
    display.drawCircle(100, 60, 7, WHITE);
    display.drawCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.setTextSize(1);
    display.display();

    // Lectura analogica de sensores opticos / Read analog optical sensors
    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    Serial.println(lectura2);
    Serial.print("    ");
    Serial.println(lectura1);

    if (lectura1 < BASE && lectura2 < BASE)  goto estado1; // 00 -> Reposo / Idle
    if (lectura1 > BASE && lectura2 < BASE)  goto estado2; // 10 -> Giro Horario (Paso 1) / CW Step 1
    if (lectura1 < BASE && lectura2 > BASE)  goto estado5; // 01 -> Giro Antihorario (Paso 1) / CCW Step 1
    goto estado1;

  // --- Secuencia Horaria (Incremento) / Clockwise Sequence (Increment) ---
  // Estado 2: Paso 10
  estado2:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EDO2 (CW-1)");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.drawCircle(10, 60, 7, WHITE);
    display.drawCircle(30, 60, 7, WHITE);
    display.drawCircle(50, 60, 7, WHITE);
    display.fillCircle(80, 60, 7, WHITE);
    display.drawCircle(100, 60, 7, WHITE);
    display.drawCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.display();

    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    if (lectura1 < BASE && lectura2 < BASE) goto estado1; // Regreso / Return
    if (lectura1 > BASE && lectura2 < BASE) goto estado2; // Mantiene / Hold
    if (lectura1 > BASE && lectura2 > BASE) goto estado3; // Avanza / Advance to 11
    goto estado2;

  // Estado 3: Paso 11
  estado3:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EDO3 (CW-2)");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.drawCircle(10, 60, 7, WHITE);
    display.drawCircle(30, 60, 7, WHITE);
    display.drawCircle(50, 60, 7, WHITE);
    display.fillCircle(80, 60, 7, WHITE);
    display.fillCircle(100, 60, 7, WHITE);
    display.drawCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.display();

    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    if (lectura2 > BASE && lectura1 < BASE) goto estado4; // Avanza a 01 / Advance to 01
    if (lectura1 > BASE && lectura2 < BASE) goto estado2; // Retrocede / Step back
    if (lectura1 < BASE && lectura2 < BASE) goto estado1; // Reposo / Idle
    goto estado3;

  // Estado 4: Paso 01 -> Incremento completado / Step 01 -> Increment complete
  estado4:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EDO4 (CW-3)");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.drawCircle(10, 60, 7, WHITE);
    display.drawCircle(30, 60, 7, WHITE);
    display.drawCircle(50, 60, 7, WHITE);
    display.fillCircle(80, 60, 7, WHITE);
    display.fillCircle(100, 60, 7, WHITE);
    display.fillCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.display();

    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    if (lectura1 > BASE && lectura2 < BASE) goto estado3;
    if (lectura1 < BASE && lectura2 < BASE) {
      variable = variable + 1; // Incremento de posicion / Increment position count
      goto estado1;
    }
    goto estado4;

  // --- Secuencia Antihoraria (Decremento) / Counter-Clockwise Sequence (Decrement) ---
  // Estado 5: Paso 01
  estado5:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EDO5 (CCW-1)");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.fillCircle(10, 60, 7, WHITE);
    display.drawCircle(30, 60, 7, WHITE);
    display.drawCircle(50, 60, 7, WHITE);
    display.drawCircle(80, 60, 7, WHITE);
    display.drawCircle(100, 60, 7, WHITE);
    display.drawCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.display();

    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    if (lectura1 < BASE && lectura2 < BASE) goto estado1;
    if (lectura1 > BASE && lectura2 > BASE) goto estado6; // Avanza a 11 / Advance to 11
    goto estado5;

  // Estado 6: Paso 11
  estado6:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EDO6 (CCW-2)");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.fillCircle(10, 60, 7, WHITE);
    display.fillCircle(30, 60, 7, WHITE);
    display.drawCircle(50, 60, 7, WHITE);
    display.drawCircle(80, 60, 7, WHITE);
    display.drawCircle(100, 60, 7, WHITE);
    display.drawCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.display();

    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    if (lectura1 > BASE && lectura2 < BASE) goto estado7; // Avanza a 10 / Advance to 10
    if (lectura1 < BASE && lectura2 > BASE) goto estado5;
    if (lectura1 < BASE && lectura2 < BASE) goto estado5;
    goto estado6;

  // Estado 7: Paso 10 -> Decremento completado / Step 10 -> Decrement complete
  estado7:
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println("EDO7 (CCW-3)");
    display.setTextSize(3);
    display.setTextColor(WHITE);
    display.setCursor(60, 20);
    display.println(variable);
    display.fillCircle(10, 60, 7, WHITE);
    display.fillCircle(30, 60, 7, WHITE);
    display.fillCircle(50, 60, 7, WHITE);
    display.drawCircle(80, 60, 7, WHITE);
    display.drawCircle(100, 60, 7, WHITE);
    display.drawCircle(120, 60, 7, WHITE);
    display.drawLine(0, 50, 128, 50, WHITE);
    display.display();

    lectura1 = analogRead(34);
    lectura2 = analogRead(35);
    if (lectura1 > BASE && lectura2 < BASE) { goto estado7; }
    if (lectura1 < BASE && lectura2 < BASE) {
      variable = variable - 1; // Decremento de posicion / Decrement position count
      goto estado1;
    }
    if (lectura1 < BASE && lectura2 < BASE) goto estado6;
    goto estado7;
}
