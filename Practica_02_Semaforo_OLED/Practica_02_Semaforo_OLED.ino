// ------------------------------------------------------------------------------
// Definicion de Pines de Salida / Output Pin Definitions
// ------------------------------------------------------------------------------
// Semaforo 1 / Traffic Light 1
int Verde = 13;      // [ES] LED Verde 1   / [EN] Green LED 1
int Amarillo = 12;   // [ES] LED Amarillo 1/ [EN] Yellow LED 1
int Rojo = 14;       // [ES] LED Rojo 1    / [EN] Red LED 1

// Semaforo 2 / Traffic Light 2
int Verde2 = 27;     // [ES] LED Verde 2   / [EN] Green LED 2
int Amarillo2 = 26;  // [ES] LED Amarillo 2/ [EN] Yellow LED 2
int Rojo2 = 25;      // [ES] LED Rojo 2    / [EN] Red LED 2

// ------------------------------------------------------------------------------
// Configuracion Inicial / System Setup
// ------------------------------------------------------------------------------
void setup() {
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C); 
  display.display(); 
  delay(2000); 
  display.clearDisplay();
  display.display();
  delay(1000);

  // Pantallas de presentacion / Presentation splash screens
  display.drawBitmap(0, 0, LogoITS, 128, 64, 1);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  delay(500);

  display.drawBitmap(0, 0, LOGO, 128, 64, 1);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  delay(500);

  display.clearDisplay(); // Portada / Cover info
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 15);
  display.println("MICROCONTROLADORES");
  display.println("P2 - Semaforo OLED");
  display.println("Iniciando sistema...");
  display.display(); 
  delay(1500);
  display.clearDisplay();
  
  // Configurar pines como salidas / Set pin modes as outputs
  pinMode(Verde, OUTPUT);
  pinMode(Amarillo, OUTPUT);
  pinMode(Rojo, OUTPUT);
  pinMode(Verde2, OUTPUT);
  pinMode(Amarillo2, OUTPUT);
  pinMode(Rojo2, OUTPUT);

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
}

// ------------------------------------------------------------------------------
// Bucle Principal / Main Loop (Traffic Light State Sequence)
// ------------------------------------------------------------------------------
void loop() {
  // Estado 1: S1 Verde (10s), S2 Rojo
  // State 1: S1 Green (10s), S2 Red
  estado1:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, HIGH);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(true, false, false, false, false, true);
    delay(10000);
    goto estado2;

  // Estados 2-8: Parpadeo de Luz Verde en S1 / Flashing Green on S1
  estado2:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, LOW);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(false, false, false, false, false, true);
    delay(1000);
    goto estado3;

  estado3:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, HIGH);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(true, false, false, false, false, true);
    delay(1000);
    goto estado4;

  estado4:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, LOW);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(false, false, false, false, false, true);
    delay(1000);
    goto estado5;

  estado5:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, HIGH);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(true, false, false, false, false, true);
    delay(1000);
    goto estado6;

  estado6:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, LOW);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(false, false, false, false, false, true);
    delay(1000);
    goto estado7;

  estado7:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, HIGH);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(true, false, false, false, false, true);
    delay(1000);
    goto estado8;

  estado8:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, LOW);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(false, false, false, false, false, true);
    delay(1000);
    goto estado9;

  // Estado 9: S1 Amarillo (3s), S2 Rojo
  // State 9: S1 Yellow (3s), S2 Red
  estado9:
    digitalWrite(Rojo, LOW);
    digitalWrite(Amarillo, HIGH);
    digitalWrite(Verde, LOW);
    digitalWrite(Rojo2, HIGH);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, LOW);
    mostrarSemaforo(false, true, false, false, false, true);
    delay(3000);
    goto etapa1;

  // Etapa 1: S1 Rojo, S2 Verde (10s)
  // Stage 1: S1 Red, S2 Green (10s)
  etapa1:
    digitalWrite(Rojo, HIGH);
    digitalWrite(Amarillo, LOW);
    digitalWrite(Verde, LOW);
    digitalWrite(Rojo2, LOW);
    digitalWrite(Amarillo2, LOW);
    digitalWrite(Verde2, HIGH);
    mostrarSemaforo(false, false, true, true, false, false);
    delay(10000);
    goto estado1;
}

// ------------------------------------------------------------------------------
// Renderizado Grafico en Pantalla OLED / Graphical OLED Rendering
// ------------------------------------------------------------------------------
void mostrarSemaforo(bool verde1, bool amarillo1, bool rojo1, bool verde2, bool amarillo2, bool rojo2) {
  display.clearDisplay();

  // [ES] Dibujar calles (interseccion vehicular) / [EN] Draw streets (road intersection)
  display.drawRect(0, 24, SCREEN_WIDTH, 16, SSD1306_WHITE);  // Calle horizontal / Horizontal street
  display.drawRect(56, 0, 16, SCREEN_HEIGHT, SSD1306_WHITE); // Calle vertical / Vertical street

  // [ES] Lineas de carril punteadas / [EN] Dotted lane divider lines
  for (int i = 0; i < SCREEN_WIDTH; i += 16) {
    display.drawLine(i, 31, i + 8, 31, SSD1306_WHITE);
  }
  for (int i = 0; i < SCREEN_HEIGHT; i += 16) {
    display.drawLine(63, i, 63, i + 8, SSD1306_WHITE);
  }

  int radio = 4; // Radio de los circulos de luz / Circle radius for lights

  // --- Semaforo 1 (Horizontal, superior izquierda / Top-left horizontal) ---
  if (rojo1)
    display.fillCircle(10, 10, radio, SSD1306_WHITE);    // Rojo ON
  else
    display.drawCircle(10, 10, radio, SSD1306_WHITE);    // Rojo OFF

  if (amarillo1)
    display.fillCircle(20, 10, radio, SSD1306_WHITE);    // Amarillo ON
  else
    display.drawCircle(20, 10, radio, SSD1306_WHITE);    // Amarillo OFF

  if (verde1)
    display.fillCircle(30, 10, radio, SSD1306_WHITE);    // Verde ON
  else
    display.drawCircle(30, 10, radio, SSD1306_WHITE);    // Verde OFF

  // --- Semaforo 2 (Vertical, inferior derecha / Bottom-right vertical) ---
  if (rojo2)
    display.fillCircle(118, 54, radio, SSD1306_WHITE); // Rojo ON
  else
    display.drawCircle(118, 54, radio, SSD1306_WHITE); // Rojo OFF

  if (amarillo2)
    display.fillCircle(118, 44, radio, SSD1306_WHITE); // Amarillo ON
  else
    display.drawCircle(118, 44, radio, SSD1306_WHITE); // Amarillo OFF

  if (verde2)
    display.fillCircle(118, 34, radio, SSD1306_WHITE); // Verde ON
  else
    display.drawCircle(118, 34, radio, SSD1306_WHITE); // Verde OFF

  display.display();
}
