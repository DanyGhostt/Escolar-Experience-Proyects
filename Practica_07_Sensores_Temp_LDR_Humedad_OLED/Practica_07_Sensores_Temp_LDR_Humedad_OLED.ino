// ------------------------------------------------------------------------------
// Pines y Sensores para ESP32 / Sensor Pin Definitions & Bus Configuration
// ------------------------------------------------------------------------------
#define ONE_WIRE_BUS 12    // [ES] Pin OneWire para DS18B20 (GPIO 12) / [EN] OneWire bus pin for DS18B20 (GPIO 12)
#define LDR_PIN 34         // [ES] Pin LDR / Luz (GPIO 34)            / [EN] LDR / Light sensor pin (GPIO 34)
#define HUMIDITY_PIN 35    // [ES] Pin Sensor de Humedad (GPIO 35)    / [EN] Soil/Water humidity sensor pin (GPIO 35)

// Inicializacion de bus OneWire y sensor Dallas / OneWire & Dallas Temp Init
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// Variables de medicion / Measurement variables
int LDR1 = 0;    // [ES] Luminosidad mapeada / [EN] Mapped Light level
int POT = 0;     // [ES] Humedad mapeada     / [EN] Mapped Humidity level
float temp = 0;  // [ES] Temperatura en °C   / [EN] Temperature in °C
int REC = 0;     // [ES] Temperatura mapeada / [EN] Mapped Temperature level
int a = 0;       // [ES] Contador de muestras/ [EN] Sample index counter

// ------------------------------------------------------------------------------
// Configuracion Inicial / System Setup
// ------------------------------------------------------------------------------
void setup() {
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C); 
  display.display(); 
  delay(2000); 
  display.clearDisplay();
  display.display();
  delay(1000);

  // Presentacion institucional / Presentation splash screens
  display.drawBitmap(0, 0, LogoITS, 128, 64, 1);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  delay(1000);

  display.drawBitmap(0, 0, Tec_ITS, 128, 64, WHITE);
  display.display();
  delay(1000);
  display.clearDisplay();

display.drawBitmap(0, 0, LOGO, 128, 64, 1);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  delay(1000);
  
  delay(2000);
  display.clearDisplay(); // Portada / Cover info
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.println("MICROCONTROLADORES");
display.println("P7-Sensores OLED");
display.display(); 
  delay(2000);
  display.clearDisplay();  

  Serial.begin(9600);

  // Inicializar pantalla OLED en direccion I2C 0x3C / Initialize OLED display at 0x3C
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("No se encontro la pantalla OLED / OLED display not found"));
    while (true);
  }

  display.clearDisplay();
  display.display();
  delay(1000);

  // Iniciar sensor de temperatura Dallas / Initialize Dallas temp sensor
  sensors.begin();

  // Cabecera serial para registro / Serial streaming header
  Serial.println("CLEARDATA");
  Serial.println("LABEL, Time, Started Time, Date, LDR, Humedad, Temperatura");
  Serial.println("RESETTIMER");

  display.clearDisplay();
}

// ------------------------------------------------------------------------------
// Bucle Principal / Main Loop (Adquisicion y Visualizacion Multisensor)
// ------------------------------------------------------------------------------
void loop() {
  // [ES] Lectura y escalado de sensores analogicos (LDR y Humedad)
  // [EN] Read and scale analog sensors (LDR Light and Humidity)
  LDR1 = map(analogRead(LDR_PIN), 0, 4095, 0, 53);
  POT = map(analogRead(HUMIDITY_PIN), 0, 4095, 0, 53);

  // [ES] Lectura del sensor digital OneWire DS18B20
  // [EN] Read OneWire DS18B20 digital temperature sensor
  sensors.requestTemperatures();
  temp = sensors.getTempCByIndex(0);  // Grados Celsius / Degrees Celsius
  REC = map(temp, -55, 125, 0, 53);   // Mapeo a altura en pixeles / Mapped to pixel height

  // [ES] Transmision de telemetria por puerto serial
  // [EN] Telemetry data transmission over serial port
  Serial.print("DATA,TIME,TIMER,DATE,");
  Serial.print(a);
  Serial.print(",");
  Serial.print(LDR1);
  Serial.print(",");
  Serial.print(POT);
  Serial.print(",");
  Serial.print(REC);
  Serial.println("");

  // ----------------------------------------------------------------------------
  // Renderizado en Pantalla OLED / OLED Screen Rendering
  // ----------------------------------------------------------------------------
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  
  // --- Barra 1: Luminosidad (LDR) / Bar 1: Light Level ---
  display.drawRect(12, 1, 32, 53, WHITE);
  display.fillRect(12, 1, 32, LDR1, WHITE);
  display.setCursor(12, 55);
  display.print(LDR1);
  display.print(" LUX");

  // --- Barra 2: Humedad / Bar 2: Humidity ---
  display.drawRect(52, 1, 32, 53, WHITE);
  display.fillRect(52, 1, 32, POT, WHITE);
  display.setCursor(52, 55);
  display.print(POT);
  display.print(" %");

  // --- Barra 3: Temperatura DS18B20 / Bar 3: Temperature ---
  display.drawRect(90, 1, 32, 53, WHITE);
  display.fillRect(90, 1, 32, REC, WHITE);
  display.setCursor(90, 55);
  display.print(temp);
  display.print(" C");

  display.display();
  
  a++;
  delay(200); // Muestreo cada 200 ms / 200ms sampling interval
}
