void loop() {
  //digitalWrite(26,HIGH);
  WiFiClient client = server.available(); // Escuchar clientes entrantes
  if (client) {
    currentTime = millis();
    previousTime = currentTime;
    Serial.println("NUEVO CLIENTE:");
    

    String header = ""; // Variable para almacenar la solicitud del cliente
    String currentLine = "";

    while (client.connected() && currentTime - previousTime <= timeoutTime) {
      currentTime = millis();

      if (client.available()) {
        char c = client.read(); // Leer el caracter
        Serial.write(c); 
        header += c; // Acumular los caracteres en el encabezado

        if (c == '\n') {  // Fin de una línea
          if (currentLine.length() == 0) {
            // Enviar respuesta HTTP
            client.println("HTTP/1.1 200 OK");
            client.println("Content-type:text/html");
            client.println();

            // Comando para cambiar el estado de los LEDs
            if (header.indexOf("GET /1/on") >= 0) {
              Serial.println("Out 1 on");
              output1State = 'T';
              digitalWrite(13, HIGH);  // Encender LED 1 (LED ROJO)
            } else if (header.indexOf("GET /1/off") >= 0) {
              Serial.println("Out 1 off");
              output1State = 'F';
              digitalWrite(13, LOW); // Apagar LED 1 (LED ROJO)
            } else if (header.indexOf("GET /2/on") >= 0) {
              Serial.println("Out 2 on");
              output2State = 'T';
              digitalWrite(12, HIGH);  // Encender LED 2 (LED VERDE)
               display.display();
            } else if (header.indexOf("GET /2/off") >= 0) {
              Serial.println("Out 2 off");
              output2State = 'F';
              digitalWrite(12, LOW); // Apagar LED 2 (LED VERDE)
