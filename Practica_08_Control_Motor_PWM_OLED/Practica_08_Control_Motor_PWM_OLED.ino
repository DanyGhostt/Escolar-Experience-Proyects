// ------------------------------------------------------------------------------
// Parametros de Modulacion PWM y Variables / PWM Configuration & Variables
// ------------------------------------------------------------------------------
const int freq = 5000;       // [ES] Frecuencia PWM: 5 kHz / [EN] PWM Frequency: 5 kHz
const int pwmChannel = 0;   // [ES] Canal LEDC 0          / [EN] LEDC PWM Channel 0
const int resolucion = 8;   // [ES] Resolucion: 8 bits    / [EN] Resolution: 8 bits (0-255)
int DUTY             = 0;   // [ES] Ciclo de trabajo      / [EN] Duty cycle value
int Entrada          = 0;   // [ES] Lectura analogica     / [EN] Analog reading value

// ------------------------------------------------------------------------------
// Configuracion Inicial / System Setup
// ------------------------------------------------------------------------------
void setup() {
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C); 
  display.display(); 
  delay(2000); 
  display.clearDisplay();
  display.display();
  delay(1000);

  // Presentacion institucional / Splash screens
  display.drawBitmap(0, 0, LogoITS, 128, 64, 1);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  delay(1000);

  display.drawBitmap(0, 0, Tec_ITS, 128, 64, WHITE);
  display.display();
  delay(1000);
  display.clearDisplay();

display.drawBitmap(0, 0, LOGO, 128, 64, 1);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  delay(1000);
  
  delay(2000);
  display.clearDisplay(); // Portada / Cover info
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.println("MICROCONTROLADORES");
display.println("P8-Control Motor PWM");
display.display(); 
  delay(2000);
  display.clearDisplay();  
  
  Serial.begin(9600);

  // Configurar canal PWM en GPIO 2 / Setup PWM channel on GPIO 2
  ledcSetup(pwmChannel, freq, resolucion);
  ledcAttachPin(2, pwmChannel);

  // Configurar botones de control de giro / Configure direction buttons
  pinMode(15 , INPUT_PULLUP); // Boton Giro Derecho / Right Turn Button
  pinMode(19 , INPUT_PULLUP); // Boton Giro Izquierdo/ Left Turn Button
  pinMode(21 , INPUT_PULLUP); // Boton Paro / Stop Button

  // Salidas hacia el puente H / H-Bridge direction control outputs
  pinMode(4  , OUTPUT);       // INA1 / INB1
  pinMode(14 , OUTPUT);       // INA2 / INB2

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
}

// ------------------------------------------------------------------------------
// Bucle Principal / Main Loop (Maquina de Estados de Control de Motor)
// ------------------------------------------------------------------------------
void loop() {
  // ----------------------------------------------------------------------------
  // Estado 1: Paro de Motor / State 1: Motor Stop
  // ----------------------------------------------------------------------------
  Estado1:
    digitalWrite(14, 0);
    digitalWrite(4 , 0);
    delay(10);
    PWM(0); // Ciclo de trabajo 0% / 0% Duty Cycle
    Serial.println(DUTY);

    // Renderizar indicador en OLED: "Paro"
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(54, 10);
    display.println("Paro");
    display.drawCircle(20, 32, 10, WHITE); // Izq / Left
    display.drawCircle(64, 32, 10, WHITE); // Centro / Center
    display.fillCircle(64, 32, 10, WHITE); // Relleno activo / Active fill
    display.drawCircle(108, 32, 10, WHITE);// Der / Right
    display.display();
    
    // Evaluacion de entradas / Check button inputs
    if (digitalRead(21) == 0 && digitalRead(15) == 0 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 0 && digitalRead(19) == 1) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 1 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 1 && digitalRead(19) == 1) goto Estado1;
    if (digitalRead(21) == 1 && digitalRead(15) == 0 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 1 && digitalRead(15) == 0 && digitalRead(19) == 1) goto Estado2; // Activa giro derecho / Right
    if (digitalRead(21) == 1 && digitalRead(15) == 1 && digitalRead(19) == 0) goto Estado3; // Activa giro izquierdo / Left
    if (digitalRead(21) == 1 && digitalRead(15) == 1 && digitalRead(19) == 1) goto Estado1;

  // ----------------------------------------------------------------------------
  // Estado 2: Giro Hacia la Derecha / State 2: Motor Rotation Right
  // ----------------------------------------------------------------------------
  Estado2:
    digitalWrite(14, 1);
    digitalWrite(4 , 0);
    delay(10);
    Entrada = analogRead(35); // Lectura de potenciometro / Read speed potentiometer
    DUTY    = map(Entrada, 0, 1024, 0, 255); 
    PWM(DUTY);
    Serial.println(DUTY);
    delay(10);

    // Renderizar indicador en OLED: "Derecha"
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(12, 10);
    display.println("Izq");
    display.setCursor(54, 10);
    display.println("Paro");
    display.setCursor(100, 10);
    display.println("Dere");
    display.drawCircle(20, 32, 10, WHITE);
    display.drawCircle(64, 32, 10, WHITE);
    display.drawCircle(108, 32, 10, WHITE);
    display.fillCircle(108, 32, 10, WHITE); // Relleno derecho activo / Right fill active
    display.display();

    if (digitalRead(21) == 0 && digitalRead(15) == 0 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 0 && digitalRead(19) == 1) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 1 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 1 && digitalRead(19) == 1) goto Estado1;
    if (digitalRead(21) == 1 && digitalRead(15) == 0 && digitalRead(19) == 0) goto Estado2;
    if (digitalRead(21) == 1 && digitalRead(15) == 0 && digitalRead(19) == 1) goto Estado2;
    if (digitalRead(21) == 1 && digitalRead(15) == 1 && digitalRead(19) == 0) goto Estado2;
    if (digitalRead(21) == 1 && digitalRead(15) == 1 && digitalRead(19) == 1) goto Estado2;

  // ----------------------------------------------------------------------------
  // Estado 3: Giro Hacia la Izquierda / State 3: Motor Rotation Left
  // ----------------------------------------------------------------------------
  Estado3:
    digitalWrite(14, 0);
    digitalWrite(4 , 1);
    delay(10);
    Entrada = analogRead(35);
    DUTY    = map(Entrada, 0, 4095, 0, 255);
    Serial.println(DUTY);
    delay(10);
    PWM(DUTY);

    // Renderizar indicador en OLED: "Izquierda"
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(12, 10);
    display.println("Izq");
    display.setCursor(54, 10);
    display.println("Paro");
    display.setCursor(100, 10);
    display.println("Dere");
    display.drawCircle(20, 32, 10, WHITE);
    display.fillCircle(20, 32, 10, WHITE); // Relleno izquierdo activo / Left fill active
    display.drawCircle(64, 32, 10, WHITE);
    display.drawCircle(108, 32, 10, WHITE);
    display.display();

    if (digitalRead(21) == 0 && digitalRead(15) == 0 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 0 && digitalRead(19) == 1) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 1 && digitalRead(19) == 0) goto Estado1;
    if (digitalRead(21) == 0 && digitalRead(15) == 1 && digitalRead(19) == 1) goto Estado1;
    if (digitalRead(21) == 1 && digitalRead(15) == 0 && digitalRead(19) == 0) goto Estado3;
    if (digitalRead(21) == 1 && digitalRead(15) == 0 && digitalRead(19) == 1) goto Estado3;
    if (digitalRead(21) == 1 && digitalRead(15) == 1 && digitalRead(19) == 0) goto Estado3;
    if (digitalRead(21) == 1 && digitalRead(15) == 1 && digitalRead(19) == 1) goto Estado3;
}

// ------------------------------------------------------------------------------
// Escritura de Ciclo de Trabajo PWM / PWM Duty Cycle Output
// ------------------------------------------------------------------------------
void PWM(int a) {
  ledcWrite(0, a);
  delay(20);
}
